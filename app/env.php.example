<?php
/**
 * BnkApp — Environment Variables Example
 *
 * This file documents all environment variables used by BnkApp.
 * The installer (install.php) generates app/env.php automatically.
 *
 * To configure manually (without the installer):
 *   cp app/env.php.example app/env.php
 *   # Then edit app/env.php with your actual values.
 *
 * Alternatively, set these as real environment variables in your
 * Nginx + PHP-FPM configuration using fastcgi_param directives:
 *
 *   fastcgi_param DB_HOST     127.0.0.1;
 *   fastcgi_param DB_PORT     3306;
 *   fastcgi_param DB_NAME     bnkapp;
 *   fastcgi_param DB_USER     bnkapp;
 *   fastcgi_param DB_PASSWORD secret;
 *   ...
 *
 * DO NOT commit app/env.php to version control — it contains secrets.
 */

// ── Database ─────────────────────────────────────────────────────────────────
putenv('DB_HOST=127.0.0.1');          // MySQL server hostname or IP
putenv('DB_PORT=3306');               // MySQL port (default: 3306)
putenv('DB_NAME=bnkapp');             // Database name
putenv('DB_USER=bnkapp');             // Database username
putenv('DB_PASSWORD=change_me');      // Database password (admin app key)
putenv('DB_PASS=change_me');          // Alias used by the portal app

// ── Application ───────────────────────────────────────────────────────────────
putenv('APP_ENV=production');         // 'production' | 'development'
putenv('APP_DEBUG=false');            // 'true' | 'false'  (never true in production)
putenv('APP_URL=https://admin.yourdomain.com');  // Admin panel base URL
putenv('APP_TIMEZONE=Europe/Berlin'); // PHP timezone

// ── Logging ───────────────────────────────────────────────────────────────────
putenv('LOG_LEVEL=warning');          // 'debug' | 'info' | 'warning' | 'error'

// ── Security ──────────────────────────────────────────────────────────────────
putenv('BCRYPT_COST=12');             // bcrypt work factor (10-14 recommended)
